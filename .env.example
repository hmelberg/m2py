# Anthropic API key for dataminimering Edge Function
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default model (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Allowed origins for dm-quick endpoint (comma-separated)
# Add your m2py production URL plus localhost for dev
M2PY_ALLOWED_ORIGINS=http://localhost:8888,https://m2py.netlify.app
